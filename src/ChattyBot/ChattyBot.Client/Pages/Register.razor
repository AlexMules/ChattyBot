@page "/register"
@using ChattyBot.Shared.Contracts.DTO
@using ChattyBot.Client.Services.ApiClients

@inject AuthClient AuthClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<div class="register-page-wrapper">
    <div class="card wide-card">
        <div class="card-header text-center">
            <h3 class="mb-0">Create ChattyBot Account</h3>
        </div>
        
        <div class="card-body p-0">
            <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />

                <div class="row g-0">
                    @* left column: Registration form *@
                    <div class="col-md-6 form-section">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 border-0 mb-3" style="background-color: #fa777c; color: #fff; font-size: 14px;">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label">Username</label>
                            <InputText @bind-Value="registerModel.Username" class="form-control" placeholder="Choose a username..." />
                            <ValidationMessage For="@(() => registerModel.Username)" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="registerModel.Email" class="form-control" placeholder="user@domain.com" />
                            <ValidationMessage For="@(() => registerModel.Email)" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Password</label>
                            <div class="input-group">
                                <InputText @bind-Value="registerModel.Password"
                                           type="@(showPassword ? "text" : "password")"
                                           class="form-control"
                                           placeholder="Enter new password..." />
        
                                <span class="btn-eye" @onclick="TogglePassword">
                                    @if (showPassword)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z" />
                                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299l.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z" />
                                            <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884l-12-12 .708-.708 12 12-.708.708z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                    }
                                </span>
                            </div>
                            <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    @* right column: Avatar Selection *@
                    <div class="col-md-6 avatar-section text-center d-flex flex-column justify-content-center">
                        <label class="form-label mb-4">Choose your avatar</label>
                        <div class="avatar-grid">
                            <img src="images/avatar1.png" alt="Avatar 1"
                                 class="avatar-img @(registerModel.AvatarPath == "avatar1.png" ? "selected" : "")"
                                 @onclick='() => registerModel.AvatarPath = "avatar1.png"' />

                            <img src="images/avatar2.png" alt="Avatar 2"
                                 class="avatar-img @(registerModel.AvatarPath == "avatar2.png" ? "selected" : "")"
                                 @onclick='() => registerModel.AvatarPath = "avatar2.png"' />
                        </div>
                        <ValidationMessage For="@(() => registerModel.AvatarPath)" class="text-danger small mt-3" />
                    </div>
                </div>

                <div class="p-4" style="background-color: #2b2d31;">
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success py-2 border-0 mb-3" style="background-color: #23a559; color: #fff; font-size: 14px;">
                            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
                        </div>
                    }
                    <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span> <span>Registering...</span>
                        }
                        else
                        {
                            <span>Complete Registration</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>

        <div class="card-footer text-center pb-4">
            <a href="/login">Already have an account? Log in here!</a>
        </div>
    </div>
</div>

@code {
    private RegisterDTO registerModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting = false;
    private bool showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("home");
        }
    }

    private void TogglePassword() => showPassword = !showPassword;

    private async Task HandleRegister()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await AuthClient.RegisterAsync(registerModel);

            if (result.IsSuccess)
            {
                successMessage = "Account created successfully! Redirecting to login page...";
                isSubmitting = false;
                StateHasChanged();
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = result.ErrorMessage;
                isSubmitting = false;
            }
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong. Please try again!";
            isSubmitting = false;
        }
    }
}