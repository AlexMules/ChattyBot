@page "/chat"
@layout EmptyLayout
@attribute [Authorize]

@using ChattyBot.Client.Services.ApiClients
@using System.Text.Json

@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IChatConversationClient ConvClient
@inject IChatMessageClient MsgClient
@inject AuthenticationStateProvider AuthProvider

<div class="chat-container">
    <aside class="sidebar @(isSidebarHidden ? "hidden" : "")">
        <div class="sidebar-top">
            <div class="toggle-area">
                <button class="hamburger-btn" @onclick="ToggleSidebar">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </button>
            </div>

            <button class="new-chat-btn" @onclick="OpenNewChatModal">
                <i class="bi bi-pencil-square"></i>
                <span>New Chat</span>
            </button>

            <div class="search-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search chat..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>

            <div class="chat-history-label">Recent Conversations</div>
            
            <div class="chat-list">
                @if (isLoadingConversations)
                {
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="chat-item skeleton-item">
                            <div class="skeleton-icon"></div>
                            <div class="skeleton-text"></div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var chat in FilteredConversations)
                    {
                        <div class="chat-item @(selectedChat?.Id == chat.Id ? "active" : "")" @onclick="() => SelectChat(chat)">
                            <div class="chat-item-content">
                                <i class="bi bi-chat-left-text"></i>
                                <span class="chat-title-text">@chat.Title</span>
                            </div>

                            <button class="chat-menu-btn" @onclick:stopPropagation="true" @onclick="() => ToggleMenu(chat.Id)">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>

                            @if (activeMenuChatId == chat.Id)
                            {
                                <div class="menu-backdrop" @onclick="() => activeMenuChatId = null"></div>
                                <div class="context-menu" @onclick:stopPropagation="true">
                                    <button class="menu-opt" @onclick="() => StartRename(chat)">
                                        <i class="bi bi-pencil"></i> Rename
                                    </button>
                                    <button class="menu-opt delete-opt" @onclick="() => ConfirmDelete(chat)">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="sidebar-bottom">
            <button class="go-back-btn" @onclick='() => Nav.NavigateTo("/home")'>
                <i class="bi bi-box-arrow-left"></i>
                <span>Go Back to Profile</span>
            </button>
        </div>
    </aside>

    <main class="chat-main">
        <header class="chat-header @(isSidebarHidden ? "shifted" : "")">
            <div class="header-left">
                @if (isSidebarHidden)
                {
                    <button class="hamburger-btn" @onclick="ToggleSidebar" style="margin-right: 15px;">
                        <span class="bar"></span>
                        <span class="bar"></span>
                        <span class="bar"></span>
                    </button>
                }
                <span class="bot-name">ChattyBot</span>
            </div>
            <div class="header-center">
                <h4 class="current-chat-title">@(selectedChat?.Title ?? "Select a conversation")</h4>
            </div>
            <div class="header-right">
                @if (selectedChat != null)
                {
                    <button class="export-header-btn" @onclick="() => showExportModal = true" title="Export Chat">
                        <i class="bi bi-file-earmark-arrow-down"></i>
                    </button>
                }
            </div>
        </header>

        <div id="messagesList" class="messages-container @(isSwitchingChat ? "switching" : "")">
            @if (selectedChat != null)
            {
                @foreach (var msg in currentMessages)
                {
                    bool isUser = msg.Sender == "User";
                    
                    <div class="message-row @(isUser ? "user-row" : "bot-row")">
                        <img src="@(isUser ? $"images/{userAvatar}" : "images/bot.png")"
                             class="message-avatar" alt="avatar" />

                        @{
                            var bubbleClass = "message-bubble";
                            if (!isUser)
                            {
                                if (msg.Type == MessageType.Trivia) bubbleClass += " trivia-mode";
                                if (msg.Type == MessageType.Image) bubbleClass += " image-mode";
                            }
                        }

                        <div class="@bubbleClass">
                            @switch (msg.Type)
                            {
                                case MessageType.Image:
                                    <ImageBubble RawContent="@msg.Content" />
                                    break;
                                case MessageType.Quote:
                                    <QuoteBubble RawContent="@msg.Content" />
                                    break;
                                case MessageType.FunFact:
                                    <FunFactBubble RawContent="@msg.Content" />
                                    break;
                                case MessageType.Help:
                                    <HelpBubble RawContent="@msg.Content" />
                                    break;
                                case MessageType.Videogame:
                                    <VideoGameBubble RawContent="@msg.Content" />
                                    break;
                                case MessageType.Music:
                                    <MusicBubble RawContent="@msg.Content" />
                                    break;
                                case MessageType.Trivia:
                                    <TriviaBubble RawContent="@msg.Content"
                                                  MessageId="@msg.Id"
                                                  OnAnswerProvided="UnblockChat" />
                                    break;
                                case MessageType.Dice:
                                    <DiceBubble RawContent="@msg.Content"
                                                IsNew="@_newlyArrivedMessageIds.Contains(msg.Id)" />
                                    break;
                                case MessageType.DiceDuel:
                                    <DiceDuelBubble RawContent="@msg.Content"
                                                    IsNew="@_newlyArrivedMessageIds.Contains(msg.Id)" />
                                    break;
                                case MessageType.CoinFlip:
                                    <CoinFlipBubble RawContent="@msg.Content"
                                                    IsNew="@_newlyArrivedMessageIds.Contains(msg.Id)" />
                                    break;
                                case MessageType.RpsDuel:
                                    <RpsBubble RawContent="@msg.Content"
                                               IsNew="@_newlyArrivedMessageIds.Contains(msg.Id)" />
                                    break;
                                default:
                                    <div class="text-content">@((MarkupString)msg.Content)</div>
                                    break;
                            }
                            <span class="msg-time">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state-wrapper">
                    <div class="empty-state-content">
            
                        <img src="images/chats_bot_image.svg" class="bot-original-icon" alt="ChattyBot Logo" />

                        <h3>Welcome to ChattyBot</h3>
                        <p>Select or create a new chat to start messaging</p>
                    </div>
                </div>
            }
        </div>

        <footer class="chat-footer">
            <div class="input-wrapper @(selectedChat == null || _isChatBlocked ? "input-disabled" : "")">
                <input type="text"
                       placeholder="@GetPlaceholderText()"
                       @bind="newMessageText"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"
                       disabled="@(selectedChat == null || _isChatBlocked)" />
               
                <button class="send-btn @(IsSendDisabled ? "btn-inactive" : "btn-active")"
                        @onclick="SendMessage"
                        disabled="@IsSendDisabled">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </footer>
    </main>
</div>

@* Modals *@
@if (showNewChatModal)
{
    <div class="modal-overlay">
        <div class="custom-modal">
            <h3>New Chat</h3>
            <input type="text" @bind="newChatTitle" placeholder="Chat name..." autofocus />
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => showNewChatModal = false">Cancel</button>
                <button class="btn-confirm" @onclick="CreateNewChat">Create</button>
            </div>
        </div>
    </div>
}

@if (showRenameModal)
{
    <div class="modal-overlay">
        <div class="custom-modal">
            <h3>Rename Chat</h3>
            <input type="text" @bind="renamedTitle" placeholder="Enter new title..." autofocus @onkeyup="HandleRenameKeyUp" />
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => showRenameModal = false">Cancel</button>
                <button class="btn-confirm" @onclick="SaveRename">Save</button>
            </div>
        </div>
    </div>
}

@if (showExportModal)
{
    <div class="modal-overlay">
        <div class="custom-modal">
            <h3>Export Conversation</h3>
            <p>Select the format you want to download:</p>
            <div class="modal-actions export-grid">
                <button class="btn-confirm" @onclick='() => HandleExport("json")'>
                    <i class="bi bi-filetype-json"></i> JSON
                </button>
                <button class="btn-confirm" @onclick='() => HandleExport("xml")'>
                    <i class="bi bi-filetype-xml"></i> XML
                </button>
            </div>
            <div class="modal-actions">
                <button class="btn-cancel" style="width: 100%" @onclick="() => showExportModal = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (showToast)
{
    <div class="toast-notification">
        <i class="bi bi-x-circle-fill"></i> @toastMessage
    </div>
}

@code {
    private bool isSidebarHidden = false;
    private bool showNewChatModal = false;
    private bool showExportModal = false;
    private bool isSwitchingChat = false;
    private bool isLoadingConversations = true;
    private bool _isChatBlocked = false;

    private string searchQuery = "";
    private string newChatTitle = "";
    private string newMessageText = "";
    private int? activeMenuChatId;
    private string userAvatar = "avatar1.png";

    private string? toastMessage;
    private bool showToast = false;

    private HashSet<int> _newlyArrivedMessageIds = new();

    private bool showRenameModal = false;
    private string renamedTitle = "";
    private ChatConversationDTO? chatToRename;

    private List<ChatConversationDTO> conversations = new();
    private List<ChatMessageDTO> currentMessages = new();
    private ChatConversationDTO? selectedChat;

    private bool IsSendDisabled => selectedChat == null || _isChatBlocked || string.IsNullOrWhiteSpace(newMessageText);

    private IEnumerable<ChatConversationDTO> FilteredConversations =>
        conversations
            .Where(c => c.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        isLoadingConversations = true;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            userAvatar = authState.User.FindFirst("avatar")?.Value ?? "avatar1.png";
            conversations = await ConvClient.GetConversationsAsync();
        }
        finally 
        { 
            isLoadingConversations = false; 
        }
    }

    private string GetPlaceholderText()
    {
        if (selectedChat == null)
        {
            return "Select a chat to start...";
        }

        if (_isChatBlocked)
        {
            return "Please answer the trivia question...";
        }

        return "Type a command (e.g. /help, /joke)...";
    }

    private void ToggleSidebar() => isSidebarHidden = !isSidebarHidden;

    private void OpenNewChatModal() 
    { 
        newChatTitle = ""; 
        showNewChatModal = true; 
    }

    private async Task CreateNewChat()
    {
        if (string.IsNullOrWhiteSpace(newChatTitle))
        {
            return;
        }

        var result = await ConvClient.CreateConversationAsync(new CreateChatDTO(newChatTitle));
        if (result != null)
        {
            conversations.Insert(0, result);
            showNewChatModal = false;
            await SelectChat(result);
        }
    }

    private async Task SelectChat(ChatConversationDTO chat)
    {
        if (selectedChat?.Id == chat.Id || isSwitchingChat)
        {
            return;
        }

        isSwitchingChat = true;
        _isChatBlocked = false;

        _newlyArrivedMessageIds.Clear();
        StateHasChanged();

        currentMessages = await MsgClient.GetChatHistoryAsync(chat.Id);
        selectedChat = chat;

        var lastMsg = currentMessages.LastOrDefault();
        if (lastMsg != null && lastMsg.Sender == "Bot" && lastMsg.Type == MessageType.Trivia)
        {
            try
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var triviaData = JsonSerializer.Deserialize<TriviaQuestionDTO>(lastMsg.Content, options);

                if (triviaData?.UserAnswerIndex == null)
                {
                    _isChatBlocked = true;
                }
            }
            catch 
            { 
                _isChatBlocked = false; 
            }
        }

        StateHasChanged();
        await ScrollToBottom(true);
        isSwitchingChat = false;
    }

    private async Task SendMessage()
    {
        if (selectedChat == null || string.IsNullOrWhiteSpace(newMessageText) || _isChatBlocked) 
        {
            return;
        }

        var messageToSend = newMessageText;
        newMessageText = "";

        var newMessages = await MsgClient.SendMessageAsync(selectedChat.Id, new SendMessageDTO(messageToSend));

        if (newMessages != null && newMessages.Any())
        {
            foreach (var m in newMessages)
            {
                _newlyArrivedMessageIds.Add(m.Id);

                if (m.Type == MessageType.Trivia)
                {
                    _isChatBlocked = true;
                }
            }

            currentMessages.AddRange(newMessages);
            StateHasChanged();
            await ScrollToBottom(false);
        }
    }

    private void UnblockChat()
    {
        _isChatBlocked = false;
        StateHasChanged();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e) 
    { 
        if (e.Key == "Enter") 
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom(bool instant)
    {
        await Task.Delay(50);
        await JS.InvokeVoidAsync("scrollToBottom", "messagesList");
    }

    private void ToggleMenu(int chatId) => activeMenuChatId = (activeMenuChatId == chatId) ? null : chatId;

    private async Task ConfirmDelete(ChatConversationDTO chat)
    {
        activeMenuChatId = null;
        if (await ConvClient.DeleteConversationAsync(chat.Id))
        {
            conversations.RemoveAll(c => c.Id == chat.Id);
            if (selectedChat?.Id == chat.Id) 
            { 
                selectedChat = null; 
                currentMessages.Clear(); 
            }
            StateHasChanged();
        }
    }

    private void StartRename(ChatConversationDTO chat)
    {
        activeMenuChatId = null; 
        chatToRename = chat; 
        renamedTitle = chat.Title; 
        showRenameModal = true;
    }

    private async Task SaveRename()
    {
        if (chatToRename != null && !string.IsNullOrWhiteSpace(renamedTitle))
        {
            if (await ConvClient.RenameConversationAsync(chatToRename.Id, new RenameChatDTO(renamedTitle)))
            {
                var index = conversations.FindIndex(c => c.Id == chatToRename.Id);
                if (index != -1)
                {
                    conversations[index] = chatToRename with { Title = renamedTitle };
                    if (selectedChat?.Id == chatToRename.Id)
                    {
                        selectedChat = conversations[index];
                    }
                }
                showRenameModal = false;
            }
        }
    }

    private async Task HandleRenameKeyUp(KeyboardEventArgs e) 
    {
        if (e.Key == "Enter") 
        { 
            await SaveRename(); 
        } 
    }

    private async Task ShowErrorToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();

        await Task.Delay(4000);
        showToast = false;
        StateHasChanged();
    }

    private async Task HandleExport(string format)
    {
        if (selectedChat == null) 
        {
            return;
        }
    
        showExportModal = false;

        try
        {
            var response = await ConvClient.ExportConversationAsync(selectedChat.Id, format);

            if (response.IsSuccessStatusCode)
            {
                var fileStream = await response.Content.ReadAsStreamAsync();
                var fileName = $"ChattyBot_Export_{DateTime.Now:yyyyMMdd}.{format}";

                using var streamRef = new DotNetStreamReference(stream: fileStream);
                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            }
        }
        catch (Exception)
        {
            await ShowErrorToast("Export failed!");
        }
    }
}