@page "/chat"
@layout EmptyLayout
@attribute [Authorize]

@using ChattyBot.Client.Services.ApiClients

@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ChatConversationClient ConvClient
@inject ChatMessageClient MsgClient
@inject AuthenticationStateProvider AuthProvider

<div class="chat-container">
    <aside class="sidebar @(isSidebarHidden ? "hidden" : "")">
        <div class="sidebar-top">
            <div class="toggle-area">
                <button class="hamburger-btn" @onclick="ToggleSidebar">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </button>
            </div>

            <button class="new-chat-btn" @onclick="OpenNewChatModal">
                <i class="bi bi-pencil-square"></i>
                <span>New Chat</span>
            </button>

            <div class="search-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search chat..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>

            <div class="chat-history-label">Recent Conversations</div>
            
            <div class="chat-list">
                @if (isLoadingConversations)
                {
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="chat-item skeleton-item">
                            <div class="skeleton-icon"></div>
                            <div class="skeleton-text"></div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var chat in FilteredConversations)
                    {
                        <div class="chat-item @(selectedChat?.Id == chat.Id ? "active" : "")" @onclick="() => SelectChat(chat)">
                            <div class="chat-item-content">
                                <i class="bi bi-chat-left-text"></i>
                                <span class="chat-title-text">@chat.Title</span>
                            </div>

                            @* 3 dots button *@
                            <button class="chat-menu-btn" @onclick:stopPropagation="true" @onclick="() => ToggleMenu(chat.Id)">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>

                            @* Context menu *@
                            @if (activeMenuChatId == chat.Id)
                            {
                                <div class="menu-backdrop" @onclick="() => activeMenuChatId = null"></div>

                                <div class="context-menu" @onclick:stopPropagation="true">
                                    <button class="menu-opt" @onclick="() => StartRename(chat)">
                                        <i class="bi bi-pencil"></i> Rename
                                    </button>
                                    <button class="menu-opt delete-opt" @onclick="() => ConfirmDelete(chat)">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="sidebar-bottom">
            <button class="go-back-btn" @onclick='() => Nav.NavigateTo("/home")'>
                <i class="bi bi-box-arrow-left"></i>
                <span>Go Back to Profile</span>
            </button>
        </div>
    </aside>

    @if (isSidebarHidden)
    {
        <button class="hamburger-btn floating-toggle" @onclick="ToggleSidebar">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    }

    <main class="chat-main">
        <header class="chat-header @(isSidebarHidden ? "shifted" : "")">
            <div class="header-left">
                <span class="bot-name">ChattyBot</span>
            </div>
            <div class="header-center">
                <h4 class="current-chat-title">@(selectedChat?.Title ?? "Select a conversation")</h4>
            </div>
            <div class="header-right"></div>
        </header>

        <div id="messagesList" class="messages-container @(isSwitchingChat ? "switching" : "")">
            @if (selectedChat != null)
            {
                @foreach (var msg in currentMessages)
                {
                    bool isUser = msg.Sender == "User";
            
                    <div class="message-row @(isUser ? "user-row" : "bot-row")">
                        @* avatar *@
                        <img src="@(isUser ? $"images/{userAvatar}" : "images/bot.png")"
                             class="message-avatar"
                             alt="avatar" />

                        @* message bubble *@
                        <div class="message-bubble">
                            @switch (msg.Type)
                            {
                                case MessageType.Image:
                                    try
                                    {
                                        var imgData = System.Text.Json.JsonSerializer.Deserialize<ImagePayload>(msg.Content);
                                        <div class="chat-image-wrapper">
                                            <img src="@imgData?.Url" class="chat-meme-img" alt="@imgData?.AltText" />
                                        </div>
                                    }
                                    catch
                                    {
                                        <div class="text-content">Image load error.</div>
                                    }
                                    break;

                                case MessageType.Quote:
                                    try
                                    {
                                        var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                                        var quoteData = System.Text.Json.JsonSerializer.Deserialize<QuotePayload>(msg.Content, options);
                
                                        @* MAGIA AICI: white-space: normal; ignoră spațiile din codul sursă *@
                                        <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 8px; width: 100%; white-space: normal;">
                                            <div style="font-style: italic; margin: 0; text-align: left;">"@quoteData?.Text"</div>
                                            <div style="margin: 0; text-align: left;">— <strong>@quoteData?.Author</strong></div>
                    
                                            @if (!string.IsNullOrWhiteSpace(quoteData?.SourceUrl))
                                            {
                                                <div style="font-size: 0.85rem; color: #9aa0a6; margin: 0; text-align: left;">
                                                    Source: <a href="@quoteData.SourceUrl" target="_blank" class="chat-link">Click here</a>
                                                </div>
                                            }
                                        </div>
                                    }
                                    catch
                                    {
                                        <div class="text-content" style="text-align: left;">@((MarkupString)msg.Content)</div>
                                    }
                                    break;

                                case MessageType.FunFact:
                                    try
                                    {
                                        var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                                        var factData = System.Text.Json.JsonSerializer.Deserialize<FunFactPayload>(msg.Content, options);
                
                                        @* MAGIA AICI: white-space: normal; *@
                                        <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 8px; width: 100%; white-space: normal;">
                                            <div style="margin: 0; text-align: left;">@factData?.Text</div>
                    
                                            @if (!string.IsNullOrWhiteSpace(factData?.SourceUrl))
                                            {
                                                <div style="font-size: 0.85rem; color: #9aa0a6; margin: 0; text-align: left;">
                                                    Source: <a href="@factData.SourceUrl" target="_blank" class="chat-link">Click here</a>
                                                </div>
                                            }
                                        </div>
                                    }
                                    catch
                                    {
                                        <div class="text-content" style="text-align: left;">@((MarkupString)msg.Content)</div>
                                    }
                                    break;

                                case MessageType.Trivia:
                                    <div class="trivia-placeholder">
                                        <i class="bi bi-controller"></i> Trivia Question Incoming...
                                    </div>
                                    break;

                                case MessageType.Help:
                                    try
                                    {
                                        var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                                        var commands = System.Text.Json.JsonSerializer.Deserialize<List<CommandHelpPayload>>(msg.Content, options);
                
                                        @* MAGIA AICI: white-space: normal; *@
                                        <div class="text-content help-content" style="text-align: left; white-space: normal;">
                                            <p class="help-title" style="margin-top: 0; margin-bottom: 12px;">Here are the commands I can help you with:</p>
                    
                                            <ul style="list-style-type: none; padding-left: 0; margin: 0;">
                                                @if (commands != null)
                                                {
                                                    @foreach (var cmd in commands)
                                                    {
                                                        <li style="margin-bottom: 6px;">
                                                            <strong>@cmd.Trigger</strong> — @cmd.Description
                                                        </li>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    }
                                    catch
                                    {
                                        <div class="text-content" style="text-align: left;">@((MarkupString)msg.Content)</div>
                                    }
                                    break;

                                default:
                                    <div class="text-content">
                                        @((MarkupString)msg.Content)
                                    </div>
                                    break;
                            }
                            <span class="msg-time">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">🤖</div>
                    <p>Select or create a new chat to start messaging</p>
                </div>
            }
        </div>

        <footer class="chat-footer">
            <div class="input-wrapper @(selectedChat == null ? "input-disabled" : "")">
                <input type="text"
                       placeholder="@(selectedChat == null ? "Select a chat to start..." : "Type a command (e.g. /joke, /help)...")"
                       @bind="newMessageText"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"
                       disabled="@(selectedChat == null)" />
               
                <button class="send-btn @(string.IsNullOrWhiteSpace(newMessageText) ? "btn-inactive" : "btn-active")"
                        @onclick="SendMessage"
                        disabled="@(selectedChat == null || string.IsNullOrWhiteSpace(newMessageText))">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </footer>
    </main>
</div>

@if (showNewChatModal)
{
    <div class="modal-overlay">
        <div class="custom-modal">
            <h3>New Chat</h3>
            <input type="text" @bind="newChatTitle" placeholder="Chat name..." autofocus />
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => showNewChatModal = false">Cancel</button>
                <button class="btn-confirm" @onclick="CreateNewChat">Create</button>
            </div>
        </div>
    </div>
}

@if (showRenameModal)
{
    <div class="modal-overlay">
        <div class="custom-modal">
            <h3>Rename Chat</h3>
            <input type="text" @bind="renamedTitle" placeholder="Enter new title..." autofocus @onkeyup="HandleRenameKeyUp" />
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => showRenameModal = false">Cancel</button>
                <button class="btn-confirm" @onclick="SaveRename">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isSidebarHidden = false;
    private bool showNewChatModal = false;
    private bool isSwitchingChat = false;
    private bool isLoadingConversations = true;

    private string searchQuery = "";
    private string newChatTitle = "";
    private string newMessageText = "";

    private int? activeMenuChatId;

    private string userAvatar = "avatar1.png"; //fallback avatar, ideally should come from user profile data

    private bool showRenameModal = false;
    private string renamedTitle = "";
    private ChatConversationDTO? chatToRename;

    private List<ChatConversationDTO> conversations = new();
    private List<ChatMessageDTO> currentMessages = new();
    private ChatConversationDTO? selectedChat;

    private IEnumerable<ChatConversationDTO> FilteredConversations =>
        conversations
            .Where(c => c.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        isLoadingConversations = true;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var avatarClaim = user.FindFirst("avatar")?.Value;
            if (!string.IsNullOrEmpty(avatarClaim))
            {
                userAvatar = avatarClaim;
            }

            conversations = await ConvClient.GetConversationsAsync();
        }
        finally
        {
            isLoadingConversations = false;
        }
    }

    private void ToggleSidebar() => isSidebarHidden = !isSidebarHidden;

    private void OpenNewChatModal()
    {
        newChatTitle = "";
        showNewChatModal = true;
    }

    private async Task CreateNewChat()
    {
        if (!string.IsNullOrWhiteSpace(newChatTitle))
        {
            var dto = new CreateChatDTO(newChatTitle);
            var result = await ConvClient.CreateConversationAsync(dto);

            if (result != null)
            {
                conversations.Insert(0, result);
                showNewChatModal = false;
                await SelectChat(result);
            }
        }
    }

    private async Task SelectChat(ChatConversationDTO chat)
    {
        if (selectedChat?.Id == chat.Id || isSwitchingChat) return;

        isSwitchingChat = true;
        StateHasChanged();

        currentMessages = await MsgClient.GetChatHistoryAsync(chat.Id);

        selectedChat = chat;
        StateHasChanged();

        await ScrollToBottom(true);
        await Task.Delay(250);

        isSwitchingChat = false;
        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (selectedChat != null && !string.IsNullOrWhiteSpace(newMessageText))
        {
            var dto = new SendMessageDTO(newMessageText);
            newMessageText = "";

            var newMessages = await MsgClient.SendMessageAsync(selectedChat.Id, dto);

            if (newMessages != null && newMessages.Any())
            {
                currentMessages.AddRange(newMessages);
                StateHasChanged();
                await ScrollToBottom(false);
            }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom(bool instant)
    {
        await Task.Delay(50);
        await JS.InvokeVoidAsync("scrollToBottom", "messagesList");
    }

    private void ToggleMenu(int chatId)
    {
        if (activeMenuChatId == chatId)
        {
            activeMenuChatId = null;
        }
        else
        {
            activeMenuChatId = chatId;
        }
    }

    private async Task ConfirmDelete(ChatConversationDTO chat)
    {
        activeMenuChatId = null;
        
        var success = await ConvClient.DeleteConversationAsync(chat.Id);

        if (success)
        {
            conversations.RemoveAll(c => c.Id == chat.Id);
            
            if (selectedChat?.Id == chat.Id)
            {
                selectedChat = null;
                currentMessages.Clear();
            }
            StateHasChanged();
        }
    }

    private void StartRename(ChatConversationDTO chat)
    {
        activeMenuChatId = null; 
        chatToRename = chat;
        renamedTitle = chat.Title; 
        showRenameModal = true;
    }

    private async Task SaveRename()
    {
        if (chatToRename != null && !string.IsNullOrWhiteSpace(renamedTitle) && renamedTitle != chatToRename.Title)
        {
            var dto = new RenameChatDTO(renamedTitle);
            var success = await ConvClient.RenameConversationAsync(chatToRename.Id, dto);

            if (success)
            {
                var index = conversations.IndexOf(chatToRename);
            
                if (index != -1)
                {
                    var updatedChat = chatToRename with { Title = renamedTitle };
                    conversations[index] = updatedChat;
                    if (selectedChat?.Id == updatedChat.Id)
                    {
                        selectedChat = updatedChat;
                    }
                }
                showRenameModal = false;
                StateHasChanged();
            }
        }
        else
        {
            showRenameModal = false;
        }
    }

    private async Task HandleRenameKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveRename();
        }
    }

    private record ImagePayload(string Url, string AltText);
    private record QuotePayload(string Text, string Author, string SourceUrl);
    private record FunFactPayload(string Text, string SourceUrl);
    private record CommandHelpPayload(string Trigger, string Description);
}