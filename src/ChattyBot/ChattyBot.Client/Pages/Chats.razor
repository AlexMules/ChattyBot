@page "/chat"
@layout EmptyLayout
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="chat-container">
    <aside class="sidebar @(isSidebarHidden ? "hidden" : "")">
        <div class="sidebar-top">
            <div class="toggle-area">
                <button class="hamburger-btn" @onclick="ToggleSidebar">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </button>
            </div>

            <button class="new-chat-btn" @onclick="OpenNewChatModal">
                <i class="bi bi-pencil-square"></i>
                <span>New Chat</span>
            </button>

            <div class="search-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search chat..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>

            <div class="chat-history-label">Recent Conversations</div>
            
            <div class="chat-list">
                @foreach (var chat in FilteredConversations)
                {
                    <div class="chat-item @(selectedChat?.Id == chat.Id ? "active" : "")" @onclick="() => SelectChat(chat)">
                        <i class="bi bi-chat-left-text"></i>
                        <span>@chat.Title</span>
                    </div>
                }
            </div>
        </div>

        <div class="sidebar-bottom">
            <button class="go-back-btn" @onclick='() => Nav.NavigateTo("/home")'>
                <i class="bi bi-box-arrow-left"></i>
                <span>Go Back to Profile</span>
            </button>
        </div>
    </aside>

    @if (isSidebarHidden)
    {
        <button class="hamburger-btn floating-toggle" @onclick="ToggleSidebar">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    }

    <main class="chat-main">
        <header class="chat-header @(isSidebarHidden ? "shifted" : "")">
            <div class="header-left">
                <span class="bot-name">ChattyBot</span>
            </div>
            <div class="header-center">
                <h4 class="current-chat-title">@(selectedChat?.Title ?? "Select a conversation")</h4>
            </div>
            <div class="header-right"></div>
        </header>

        <div id="messagesList" class="messages-container @(isSwitchingChat ? "switching" : "")">
            @if (selectedChat != null)
            {
                @foreach (var msg in selectedChat.Messages)
                {
                    <div class="message-row @(msg.Sender == MessageSender.User ? "user-row" : "bot-row")">
                        <div class="message-bubble">
                            @msg.Content
                            <span class="msg-time">@msg.Timestamp.ToString("HH:mm")</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">🤖</div>
                    <p>Select or create a new chat to start messaging</p>
                </div>
            }
        </div>

        <footer class="chat-footer">
            <div class="input-wrapper @(selectedChat == null ? "input-disabled" : "")">
                <input type="text"
                       placeholder="@(selectedChat == null ? "Select a chat to start..." : "Type a command (e.g. /joke, /help)...")"
                       @bind="newMessageText"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"
                       disabled="@(selectedChat == null)" />
               
                <button class="send-btn @(string.IsNullOrWhiteSpace(newMessageText) ? "btn-inactive" : "btn-active")"
                        @onclick="SendMessage"
                        disabled="@(selectedChat == null || string.IsNullOrWhiteSpace(newMessageText))">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </footer>
    </main>
</div>

@if (showNewChatModal)
{
    <div class="modal-overlay">
        <div class="custom-modal">
            <h3>New Chat</h3>
            <input type="text" @bind="newChatTitle" placeholder="Chat name..." autofocus />
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="() => showNewChatModal = false">Cancel</button>
                <button class="btn-confirm" @onclick="CreateNewChat">Create</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isSidebarHidden = false;
    private bool showNewChatModal = false;
    private bool isSwitchingChat = false;
    private string searchQuery = "";
    private string newChatTitle = "";
    private string newMessageText = "";

    private List<ChatConversation> conversations = new()
    {
        new ChatConversation { Id = 1, Title = "General Discussion", CreatedAt = DateTime.Now.AddHours(-1), Messages = new() {
            new ChatMessage { Content = "Hello! How can I help you today?", Sender = MessageSender.Bot, Timestamp = DateTime.Now.AddHours(-1) }
        }}
    };

    private ChatConversation? selectedChat;

    private IEnumerable<ChatConversation> FilteredConversations =>
        conversations
            .Where(c => c.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.CreatedAt);

    private void ToggleSidebar() => isSidebarHidden = !isSidebarHidden;

    private void OpenNewChatModal()
    {
        newChatTitle = "";
        showNewChatModal = true;
    }

    private async Task CreateNewChat()
    {
        if (!string.IsNullOrWhiteSpace(newChatTitle))
        {
            var nc = new ChatConversation
            {
                Id = conversations.Any() ? conversations.Max(c => c.Id) + 1 : 1,
                Title = newChatTitle,
                CreatedAt = DateTime.Now,
                Messages = new()
            };

            conversations.Insert(0, nc);
            selectedChat = nc;
            showNewChatModal = false;

            await ScrollToBottom(true);
        }
    }

    private async Task SelectChat(ChatConversation chat)
    {
        if (selectedChat?.Id == chat.Id || isSwitchingChat) return;

        isSwitchingChat = true;
        StateHasChanged();

        // Wait for fade out to complete before switching chat
        await Task.Delay(250);

        selectedChat = chat; 
        StateHasChanged();

        await ScrollToBottom(true);

        await Task.Delay(150);

        isSwitchingChat = false; 
        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (selectedChat != null && !string.IsNullOrWhiteSpace(newMessageText))
        {
            selectedChat.Messages.Add(new ChatMessage { Content = newMessageText, Sender = MessageSender.User, Timestamp = DateTime.Now });
            newMessageText = "";
            StateHasChanged();
            await ScrollToBottom(false);

            await Task.Delay(800);
            selectedChat.Messages.Add(new ChatMessage { Content = "I'm a bot! Soon I'll be connected to the DB.", Sender = MessageSender.Bot, Timestamp = DateTime.Now });
            StateHasChanged();
            await ScrollToBottom(false);
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await SendMessage(); }

    private async Task ScrollToBottom(bool instant)
    {
        await Task.Delay(20);
        await JS.InvokeVoidAsync("scrollToBottom", "messagesList");
    }
}