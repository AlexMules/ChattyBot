@page "/home"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize]

<div class="profile-settings-container">
    <div class="user-profile-card">
        
        @* banner *@
        <div class="profile-banner">
            <h4 class="welcome-on-banner">Welcome, @Username!</h4>
        </div>

        @* header *@
        <div class="profile-header-section">
            <div class="avatar-container">
                <img src="images/@UserAvatar" alt="Avatar" class="profile-picture" />
                <div class="status-indicator online"></div>
            </div>
            
            <div class="header-info">
                <div class="name-badge-row">
                    <h2 class="display-name">@Username</h2>
                    <div class="badge-icon">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                </div>
                <button class="btn btn-blurple btn-sm mt-2" @onclick="GoToManage">Edit User Profile</button>
            </div>
        </div>

        @* user details *@
        <div class="details-container">
            <div class="details-box">
                
                @* username row *@
                <div class="detail-row">
                    <div class="detail-info">
                        <span class="detail-label">Username</span>
                        <span class="detail-value">@Username.ToLower()</span>
                    </div>
                    <button class="btn btn-discord-secondary btn-sm" @onclick="GoToManage">Edit</button>
                </div>

                @* email row *@
                <div class="detail-row">
                    <div class="detail-info">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">
                            @MaskEmail(Email)
                            <span class="reveal-link" @onclick="ToggleReveal">@(isRevealed ? "Hide" : "Reveal")</span>
                        </span>
                    </div>
                    <button class="btn btn-discord-secondary btn-sm" @onclick="GoToManage">Edit</button>
                </div>

            </div>
        </div>

    </div>
</div>

@code {
    private string Username = "Loading...";
    private string Email = "Loading...";
    private string UserAvatar = "avatar1.png"; // fallback avatar
    private bool isRevealed = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            Username = user.Identity.Name ?? "Unknown User";

            Email = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value
                    ?? user.FindFirst("email")?.Value
                    ?? "No email found";

            var avatarClaim = user.FindFirst("avatar")?.Value;
            if (!string.IsNullOrEmpty(avatarClaim))
            {
                UserAvatar = avatarClaim;
            }
        }
    }

    private void GoToManage() => Navigation.NavigateTo("/account/manage");

    private void ToggleReveal() => isRevealed = !isRevealed;

    private string MaskEmail(string email)
    {
        if (string.IsNullOrEmpty(email) || !email.Contains('@')) 
        {
            return email;
        }

        if (isRevealed)
        {
            return email;
        }

        var parts = email.Split('@');
        string username = parts[0];
        string domain = parts[1];

        string maskedUsername = new string('*', username.Length);

        return $"{maskedUsername}@{domain}";
    }
}