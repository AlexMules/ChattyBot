@using System.Text.Json

@if (commands != null)
{
    <div class="help-container" style="text-align: left; white-space: normal;">
        <p style="margin: 0 0 15px 0; font-weight: bold; color: #aaa; font-size: 0.9rem;">
            Here are the commands I can help you with:
        </p>
        
        <div style="display: grid; grid-template-columns: auto auto 1fr; row-gap: 15px; column-gap: 8px; align-items: start;">
            @foreach (var cmd in commands)
            {
                <div style="font-weight: bold; color: #fff; white-space: nowrap;">@cmd.Trigger</div>

                <div style="color: #888;">—</div>

                <div style="display: flex; flex-direction: column; align-items: flex-start;">
                    @{
                        var parts = cmd.Description.Split('|');
                        <span style="color: #e0e0e0;">@parts[0]</span>
                        
                        if (parts.Length > 1)
                        {
                            <div style="font-size: 0.9rem; color: #8e67d5; font-style: italic; margin-top: 4px; font-weight: 500;">
                                @parts[1]
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string RawContent { get; set; } = string.Empty;
    private List<CommandHelpPayload>? commands;

    protected override void OnParametersSet()
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            commands = JsonSerializer.Deserialize<List<CommandHelpPayload>>(RawContent, options);
        }
        catch { commands = null; }
    }

    private record CommandHelpPayload(string Trigger, string Description);
}