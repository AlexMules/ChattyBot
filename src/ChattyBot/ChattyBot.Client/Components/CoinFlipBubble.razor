@using System.Text.Json

<div class="coin-container-scene">
    <div class="coin-fixed-area">
        <div id="coin" class="@GetAnimationClass()">
            <div class="side-a">H</div>
            <div class="side-b">T</div>
        </div>
    </div>

    @if (!isAnimating && !string.IsNullOrEmpty(finalResult))
    {
        <div class="coin-label">It's <b>@finalResult</b>!</div>
    }
</div>

@code {
    [Parameter] public string RawContent { get; set; } = string.Empty;
    [Parameter] public bool IsNew { get; set; } = false;

    private string? finalResult;
    private bool isAnimating = false;

    private string GetAnimationClass()
    {
        if (isAnimating) return finalResult == "Heads" ? "heads-anim" : "tails-anim";
        return finalResult == "Heads" ? "static-heads" : "static-tails";
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var data = JsonSerializer.Deserialize<JsonElement>(RawContent);
            string result = data.GetProperty("Result").GetString() ?? "";

            if (result != finalResult)
            {
                finalResult = result;
                if (IsNew && !isAnimating)
                {
                    isAnimating = true;
                    StateHasChanged();
                    await Task.Delay(3000);
                    isAnimating = false;
                    StateHasChanged();
                }
            }
        }
        catch
        {
            isAnimating = false;
        }
    }
}