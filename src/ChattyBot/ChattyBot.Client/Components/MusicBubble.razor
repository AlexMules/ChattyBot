@using System.Text.Json

@if (songData != null)
{
    <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 8px; width: 100%; white-space: normal;">
        <div style="text-align: left;">
            <h5 style="margin: 0; color: #00d4ff; font-weight: bold; font-size: 1.1rem;">
                @songData.Title
            </h5>
            
            <div style="font-size: 0.9rem; color: #aaa; margin-bottom: 6px;">
                by <strong style="color: #eee;">@songData.Artist</strong>
            </div>
            
            <p style="margin: 0 0 12px 0; font-size: 0.85rem; line-height: 1.5; color: #ccc;">
                @songData.Description
            </p>

            @if (!string.IsNullOrEmpty(songData.SongPath))
            {
                <a href="@songData.SongPath" target="_blank"
                       style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: #cc0000; color: white; border-radius: 6px; text-decoration: none; font-size: 0.8rem; font-weight: bold; transition: background 0.2s;">
                    <i class="bi bi-play-fill"></i> Listen on YouTube
                </a>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string RawContent { get; set; } = string.Empty;
    private SongPayload? songData;

    protected override void OnParametersSet()
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            songData = JsonSerializer.Deserialize<SongPayload>(RawContent, options);
        }
        catch { songData = null; }
    }

    private record SongPayload(string Title, string Artist, string Description, string SongPath);
}