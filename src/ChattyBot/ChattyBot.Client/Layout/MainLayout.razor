@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">Welcome, <strong>@context.User.Identity?.Name</strong>!</span>
                    <a href="logout" class="btn btn-sm btn-outline-secondary">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="me-2">Login</a>
                    <a href="register">Înregistrare</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>