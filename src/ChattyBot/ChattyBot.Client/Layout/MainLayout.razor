@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="ms-auto">
                <AuthorizeView>
                    <Authorized>
                        <a href="logout" class="btn btn-sm btn-outline-light">Logout</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="me-3 text-decoration-none text-white-50">Login</a>
                        <a href="register" class="btn btn-sm btn-blurple">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>